{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "cachyos_small",
    "height": 11,
    "padding": {
      "top": 2
    },
    "color": {
      "1": "#65bdcc",
      "2": "#646fcc"
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "#65bdcc",
      "title": "#646fcc",
      "output": "#8fcdd8",
      "separator": "#646fcc"
    },
    "percent": {
      "color": {
        "green": "#8fcdd8",
        "yellow": "#65bdcc",
        "red": "#646fcc"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "                  󰌢  [ SYSTEM INFO ]",
      "outputColor": "#65bdcc"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────────┐",
      "outputColor": "#65bdcc"
    },
    {
      "type": "os",
      "key": "    OS",
      "keyColor": "#65bdcc"
    },
    {
      "type": "packages",
      "key": "  󰏗  Packages",
      "keyColor": "#65bdcc"
    },
    {
      "type": "wm",
      "key": "    WM",
      "keyColor": "#65bdcc"
    },
    {
      "type": "terminal",
      "key": "    Terminal",
      "keyColor": "#65bdcc"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘",
      "outputColor": "#65bdcc"
    },
    "break",
    {
      "type": "title",
      "key": "    User",
      "keyColor": "#646fcc"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────────┐",
      "outputColor": "#646fcc"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "    CPU",
      "keyColor": "#646fcc"
    },
    {
      "type": "memory",
      "key": "  󰘚  Memory",
      "keyColor": "#646fcc"
    },
    {
      "type": "uptime",
      "key": "  󰅐  Uptime",
      "keyColor": "#646fcc"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘",
      "outputColor": "#646fcc"
    },
    {
      "type": "custom",
      "format": "               \u001b[30m󰊠  \u001b[31m󰊠  \u001b[32m󰊠  \u001b[33m󰊠  \u001b[34m󰊠  \u001b[35m󰊠  \u001b[36m󰊠  \u001b[37m󰊠  \u001b[0m"
    }
  ]
}
